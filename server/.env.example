# Copy to .env and fill in. Never commit .env.
# Run with: npm start  (node --env-file=.env index.ts, Node 22.18+)
PORT=8789
ANTHROPIC_API_KEY=
DEEPGRAM_API_KEY=
# Quick tasks (skills, follow-ups, reading resumes) and the interview plan
FAST_MODEL=claude-haiku-5-5
ASSIST_MODEL=claude-sonnet-5-5
# Any long random string. The extension sends it on every request.
DEBRIEF_APP_TOKEN=
# Limits (each AI call and speech key costs money). Per client, per minute:
AI_CALLS_PER_MINUTE=30
TRANSCRIBE_KEYS_PER_MINUTE=6
BAD_TOKEN_PER_MINUTE=10
# Everyone together, per day (UTC). 0 = no cap.
DAILY_AI_CALLS=2000
DAILY_TRANSCRIBE_KEYS=500
# Set to 1 behind a host's proxy, so limits use the visitor's address (X-Forwarded-For), not the proxy's.
TRUST_PROXY=
