# Copy to .env and fill in. Never commit .env.
# Run with: npm start  (node --env-file=.env index.ts, Node 22.18+)
PORT=8789
ANTHROPIC_API_KEY=
DEEPGRAM_API_KEY=
# Quick tasks (skills, follow-ups, reading resumes) and the interview plan
FAST_MODEL=claude-haiku-5-5
ASSIST_MODEL=claude-sonnet-5-5
# Any long random string. The extension sends it on every request.
DEBRIEF_APP_TOKEN=
