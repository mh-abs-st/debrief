{
  "manifest_version": 3,
  "name": "Debrief",
  "version": "0.1.0",
  "description": "Interview notes for hiring teams: skills checklist, live transcript, follow-up questions and plans. No candidate scores.",
  "permissions": [
    "sidePanel",
    "storage",
    "tabs",
    "tabCapture",
    "activeTab"
  ],
  "host_permissions": [
    "http://localhost:8789/*",
    "https://api.deepgram.com/*",
    "wss://api.deepgram.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "panel.html"
  },
  "action": {
    "default_title": "Open Debrief"
  }
}
