{
  "manifest_version": 3,
  "name": "Debrief",
  "version": "0.1.0",
  "description": "Interview notes for hiring teams: skills checklist, live transcript, follow-up questions and plans. No candidate scores.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "sidePanel",
    "storage",
    "unlimitedStorage",
    "tabs",
    "tabCapture",
    "activeTab"
  ],
  "host_permissions": [
    "http://localhost:8789/*",
    "https://api.deepgram.com/*",
    "wss://api.deepgram.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+D",
        "mac": "Alt+Shift+D"
      },
      "description": "Open Debrief on this tab (lets it listen to the call)"
    }
  },
  "side_panel": {
    "default_path": "panel.html"
  },
  "action": {
    "default_title": "Open Debrief",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png"
    }
  }
}
